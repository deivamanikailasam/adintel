{
 "uid": "adintel-quality",
 "title": "AdIntel \u2014 Quality & safety",
 "tags": [
  "adintel"
 ],
 "timezone": "browser",
 "schemaVersion": 39,
 "refresh": "30s",
 "time": {
  "from": "now-24h",
  "to": "now"
 },
 "panels": [
  {
   "id": 1,
   "type": "timeseries",
   "title": "Recommendation decisions",
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (decision) (increase(adintel_recommendation_decisions_total[7d]))",
     "legendFormat": "{{decision}}"
    }
   ]
  },
  {
   "id": 2,
   "type": "stat",
   "title": "Approval rate (7d)",
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(increase(adintel_recommendation_decisions_total{decision=~\"approved|modified\"}[7d])) / clamp_min(sum(increase(adintel_recommendation_decisions_total[7d])),1)",
     "legendFormat": "{{label}}"
    }
   ]
  },
  {
   "id": 3,
   "type": "timeseries",
   "title": "Rejection reasons",
   "gridPos": {
    "x": 0,
    "y": 8,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (category) (increase(adintel_rejection_reasons_total[7d]))",
     "legendFormat": "{{category}}"
    }
   ]
  },
  {
   "id": 4,
   "type": "timeseries",
   "title": "Anomaly dismissals by reason",
   "gridPos": {
    "x": 12,
