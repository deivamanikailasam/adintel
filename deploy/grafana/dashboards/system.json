{
 "uid": "adintel-system",
 "title": "AdIntel \u2014 System",
 "tags": [
  "adintel"
 ],
 "timezone": "browser",
 "schemaVersion": 39,
 "refresh": "30s",
 "time": {
  "from": "now-24h",
  "to": "now"
 },
 "panels": [
  {
   "id": 1,
   "type": "timeseries",
   "title": "API requests/s by status",
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (status) (rate(adintel_http_requests_total[5m]))",
     "legendFormat": "{{status}}"
    }
   ]
  },
  {
   "id": 2,
   "type": "timeseries",
   "title": "API p95 latency",
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.95, sum by (le, route) (rate(adintel_http_request_seconds_bucket[5m])))",
     "legendFormat": "{{route}}"
    }
   ]
  },
  {
   "id": 3,
   "type": "timeseries",
   "title": "Queue depth",
   "gridPos": {
    "x": 0,
    "y": 8,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "max by (queue) (adintel_queue_depth)",
     "legendFormat": "{{queue}}"
    }
   ]
  },
  {
   "id": 4,
   "type": "timeseries",
   "title": "DLQ depth",
   "gridPos": {
    "x": 12,
    "y": 8,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "max by (queue) (adintel_dlq_depth)",
     "legendFormat": "{{queue}}"
    }
   ]
  }
 ]
}