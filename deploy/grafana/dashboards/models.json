{
 "uid": "adintel-models",
 "title": "AdIntel \u2014 Models & cost (notional)",
 "tags": [
  "adintel"
 ],
 "timezone": "browser",
 "schemaVersion": 39,
 "refresh": "30s",
 "time": {
  "from": "now-24h",
  "to": "now"
 },
 "panels": [
  {
   "id": 1,
   "type": "timeseries",
   "title": "Notional cost by agent (24h)",
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "currencyUSD"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (agent) (increase(adintel_llm_cost_usd_total[24h]))",
     "legendFormat": "{{agent}}"
    }
   ]
  },
  {
   "id": 2,
   "type": "timeseries",
   "title": "Notional cost by tenant (24h)",
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "currencyUSD"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (tenant) (increase(adintel_llm_cost_usd_total[24h]))",
     "legendFormat": "{{tenant}}"
    }
   ]
  },
  {
   "id": 3,
   "type": "timeseries",
   "title": "Tokens by model",
   "gridPos": {
    "x": 0,
    "y": 8,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (model, direction) (rate(adintel_llm_tokens_total[15m]))",
     "legendFormat": "{{model}} {{direction}}"
    }
   ]
  },
  {
   "id": 4,
   "type": "timeseries",
   "title": "Model latency p95",
   "gridPos": {
    "x": 12,
    "y": 8,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.95, sum by (le, model) (rate(adintel_llm_call_seconds_bucket[15m])))",
     "legendFormat": "{{model}}"
    }
   ]
  },
  {
   "id": 5,
   "type": "timeseries",
   "title": "Validation failures / repairs / fallbacks",
   "gridPos": {
    "x": 0,
    "y": 16,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(increase(adintel_llm_validation_failures_total[1h])) or vector(0)",
     "legendFormat": "validation failures"
    }
   ]
  },
  {
   "id": 6,
   "type": "timeseries",
   "title": "Cache hit rate",
   "gridPos": {
    "x": 12,
    "y": 16,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (cache) (rate(adintel_cache_lookups_total{result=\"hit\"}[1h])) / sum by (cache) (rate(adintel_cache_lookups_total[1h]))",
     "legendFormat": "{{cache}}"
    }
   ]
  },
  {
   "id": 7,
   "type": "timeseries",
   "title": "Chat first token p95",
   "gridPos": {
    "x": 0,
    "y": 24,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.95, sum by (le) (rate(adintel_llm_first_token_seconds_bucket[15m])))",
     "legendFormat": "p95"
    }
   ]
  }
 ]
}