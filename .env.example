# Copy to .env and adjust. Every variable is optional locally; the defaults run the zero-dependency
# in-memory mode. Variables marked [PROD] MUST be changed outside `local` — startup refuses otherwise.

ADINTEL_ENV=local                       # local | test | staging | production

# --- storage & queues -----------------------------------------------------------------------------
ADINTEL_STORAGE=memory                  # memory (no Docker) | mongo (Atlas Local via `make up`)
ADINTEL_MONGO_URI=mongodb://localhost:27017/?directConnection=true
ADINTEL_MONGO_DB=adintel
ADINTEL_VECTOR_SEARCH=auto              # auto | atlas ($vectorSearch) | python (brute force)
ADINTEL_QUEUE=memory                    # memory | redis | sqs
ADINTEL_REDIS_URL=redis://localhost:6379/0
ADINTEL_SHARED_STATE=memory            # memory | redis (rate limits + semantic cache shared across processes)

# --- models (mlx-lm) ------------------------------------------------------------------------------
ADINTEL_LLM_PROVIDER=openai_compat      # openai_compat (mlx-lm, vLLM, ...) | bedrock | mock
# Override config/models.yaml per machine if your model names or ports differ:
# ADINTEL_MODEL_SMALL_ID=mlx-community/Qwen3.6-35B-A3B-4bit
# ADINTEL_MODEL_SMALL_BASE_URL=http://127.0.0.1:8080/v1
# ADINTEL_MODEL_FRONTIER_ID=mlx-community/Qwen3.8-27B-8bit
# ADINTEL_MODEL_FRONTIER_BASE_URL=http://127.0.0.1:8081/v1
# ADINTEL_REPORT_ADAPTER_PATH=finetune/adapters/report-neutral-v1
# ADINTEL_REPORT_ADAPTER_SHA256=<sha256 printed by finetune/sign_adapter.py>
ADINTEL_QWEN_NO_THINK=true              # append Qwen's /no_think switch for structured calls

# --- retrieval ------------------------------------------------------------------------------------
ADINTEL_EMBEDDER=hashing                # hashing (offline, deterministic) | fastembed (BGE, needs .[ml])
ADINTEL_RERANKER=lexical                # lexical | fastembed (BGE cross-encoder)

# --- tools ----------------------------------------------------------------------------------------
ADINTEL_SANDBOX=subprocess              # subprocess | docker (network-isolated container)
ADINTEL_CONNECTORS=synthetic            # synthetic | csv (your exports in data/import, manual execution) | live
# ADINTEL_CSV_DIR=data/import
ADINTEL_SECRETS=file                    # file (secrets/ dir) | aws (Secrets Manager)

# --- auth & approvals [PROD] ----------------------------------------------------------------------
ADINTEL_JWT_SECRET=dev-only-jwt-secret-change-me-0123456789
ADINTEL_APPROVAL_SIGNING_KEY=dev-only-approval-signing-key-0123456789
ADINTEL_DEV_LOGIN_ENABLED=true
ADINTEL_AUTH_MODE=dev                   # dev | oidc | both (production: oidc)
# ADINTEL_OIDC_ISSUER=http://localhost:8180/realms/adintel     # Keycloak from `make up`
# ADINTEL_OIDC_AUDIENCE=adintel-api
# ADINTEL_OIDC_TENANT_CLAIM=tenant_id    # Cognito: custom:tenant_id
# ADINTEL_OIDC_ROLES_CLAIM=realm_access.roles   # Cognito: cognito:groups
ADINTEL_RECOMMENDATION_TTL_HOURS=72

# --- per-run budget (harness) ---------------------------------------------------------------------
ADINTEL_RUN_MAX_STEPS=25
ADINTEL_RUN_MAX_TOKENS=400000
ADINTEL_RUN_MAX_COST_USD=2.00
ADINTEL_RUN_MAX_WALL_SECONDS=900
ADINTEL_TENANT_DAILY_COST_CAP_USD=25.00

# --- observability (all optional) -----------------------------------------------------------------
ADINTEL_LOG_LEVEL=INFO
ADINTEL_LOG_JSON=true
# ADINTEL_OTEL_ENDPOINT=http://localhost:4318         # Jaeger OTLP/HTTP from `make up`
# ADINTEL_LANGFUSE_HOST=http://localhost:3000
# ADINTEL_LANGFUSE_PUBLIC_KEY=pk-lf-...
# ADINTEL_LANGFUSE_SECRET_KEY=sk-lf-...
# ADINTEL_ALERT_WEBHOOK_URL=https://hooks.slack.com/services/...
