# Node / Angular
node_modules/
frontend/dist/
frontend/.angular/

# Terraform
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
.terraform.lock.hcl

# OS / editors
.DS_Store
.idea/
.vscode/

